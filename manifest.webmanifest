{
  "name": "四级成绩分析",
  "short_name": "四级成绩分析",
  "description": "录入四级各部分答对题数，按官方分值结构折算 710 分制报道分，查看趋势图表并获得针对性提分建议。",
  "lang": "zh-CN",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#f6f7fb",
  "theme_color": "#5b5bf5",
  "categories": [
    "education",
    "productivity"
  ],
  "icons": [
    {
      "src": "assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "assets/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "id": "./",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "shortcuts": [
    {
      "name": "录入成绩",
      "short_name": "录入",
      "url": "./#entry",
      "description": "快速录入一次四级成绩"
    },
    {
      "name": "查看分析",
      "short_name": "分析",
      "url": "./#analysis",
      "description": "查看针对性提分建议"
    },
    {
      "name": "历史记录",
      "short_name": "记录",
      "url": "./#records",
      "description": "查看全部成绩记录"
    }
  ]
}
